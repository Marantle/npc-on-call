# Copy this file to .env and fill it in. Never share .env, it holds your keys.

DISCORD_TOKEN=
ANTHROPIC_API_KEY=
AZURE_SPEECH_KEY=
# The region of your Azure Speech resource, for example westeurope or eastus
AZURE_SPEECH_REGION=
ELEVENLABS_API_KEY=

# The voice's ID, not its name. In ElevenLabs, open the voice and copy its ID.
ELEVENLABS_VOICE_ID=
# Optional. A second voice that narrates what the character does, like a DM.
# Leave it empty and the character only talks.
NARRATOR_VOICE_ID=

# true makes the character answer everything anyone says, no name needed.
# Handy when you test alone. Leave it false for a real session.
SOLO_MODE=false

# The bot answers when someone says this name out loud.
CHARACTER_NAME=Grimbold
# Other spellings the name comes out as in the transcript, comma separated.
# Check the terminal during play and add the ones you see.
CALL_NAMES=Grimbald,Grim bold

# claude-opus-5-5, claude-sonnet-5-5 or claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5

# The language you speak at the table, fi-FI for Finnish.
SPEECH_LANGUAGE=en-US

# The scene that plays when the bot starts: a file in scenes/ without .md.
# Type !<name> in Discord to switch, for example !invitation.
SCENE=dinner
